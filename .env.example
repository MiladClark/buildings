DATABASE_URL=postgresql://vahedban:local-development-only@127.0.0.1:5432/vahedban
POSTGRES_PASSWORD=replace-with-random-hex-password
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3300
# Optional Google OAuth web client; runtime only, never commit downloaded credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional comma-separated origins, for example a reverse-proxy address.
BETTER_AUTH_TRUSTED_ORIGINS=
CHAT_UPLOAD_DIR=./data/chat-uploads
# Optional Web Push keys: leave BOTH unset to generate once in the runtime database.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://vahedban.ir
# Worker: production entrypoints default to 1; set 0 to pause automatic delivery.
# NOTIFICATION_WORKER_ENABLED=1
# Coolify runtime: BETTER_AUTH_URL=https://vahedban.ir
# DATABASE_URL is assembled by Docker Compose for the private postgres service.
# CHAT_UPLOAD_DIR=/app/data/chat-uploads
# Mount a persistent volume at /app/data. Never pass production secrets at build time.
# INITIAL_IMPORT_BUNDLE is only for the first transfer, then remove it from Coolify.
